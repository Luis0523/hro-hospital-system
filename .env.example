# ==============================================================================
# VARIABLES DE ENTORNO GLOBALES - SISTEMA HOSPITALARIO HRO
# ==============================================================================

# PostgreSQL
POSTGRES_DB=hro_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_PORT=5432

# Backend (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://postgres:5432/hro_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_password

# Redis (Caché / PubSub)
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend (React)
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080/ws-turnos
