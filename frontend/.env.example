# API REST del backend (Spring Boot, context-path /api/v1)
# En desarrollo se usa el proxy de Vite, por eso la ruta relativa.
VITE_API_URL=/api/v1

# Endpoint STOMP/SockJS (topics: /topic/tablero y /topic/clinica/{asignacionDiariaEspacioId})
VITE_WS_URL=/api/v1/ws-turnos

# Destino del proxy de Vite hacia el backend (solo desarrollo)
# Desplegado: https://hro-hospital-api.fly.dev  |  Local: http://localhost:8081
VITE_BACKEND_URL=https://hro-hospital-api.fly.dev

# true = datos de prueba (mock); false o ausente = backend real.
# En modo test (Vitest) siempre se usa mock automáticamente.
VITE_USE_MOCK=false

# FALLBACK build-time (legacy). La configuración por TV es ahora en runtime:
#   /tablero?sala=1..4  +  /tablero-config.json
# Esta variable solo se usa cuando la URL NO trae ?sala.
# IDs de asignacionDiariaEspacioId separados por coma.
# Ejemplo: VITE_TABLERO_ASIGNACIONES=1,2,5
# Vacío o ausente = mostrar todas las asignaciones recibidas.
VITE_TABLERO_ASIGNACIONES=

# Duración en ms de la vista de llamado cuando la voz está desactivada o no
# disponible (cuando hay voz, la duración la marca onEnd/onError).
# Ausente o inválido = 6000.
VITE_TABLERO_LLAMADO_MS=6000

# SOLO DESARROLLO + MOCK. Genera N asignaciones ficticias para revisar el
# tablero con volumen. Valores aceptados: 10, 25, 50, 100.
# Vacío/ausente/otro = mock normal (4 asignaciones).
# En producción (build) se ignora por completo; no es configuración productiva.
VITE_TABLERO_MOCK_VOLUMEN=

# SOLO DESARROLLO + MOCK (requiere VITE_USE_MOCK=true).
# Habilita controles manuales ("Simular llamado" / "Re-llamar") para probar el
# flujo real: pipeline WS → FIFO → LlamadoGrande → voz x2 → regreso a tabla.
# En producción (build) queda inactivo.
VITE_TABLERO_SIMULADOR_LLAMADO=
